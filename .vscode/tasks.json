{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cargo build debug-cli",
      "type": "shell",
      "command": "cargo build --bin debug-cli",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$rustc",
      "group": "build"
    },
    {
      "label": "cargo build server",
      "type": "shell",
      "command": "cargo build --bin taikyokushogi-server",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$rustc",
      "group": "build"
    },
    {
      "label": "cargo test",
      "type": "shell",
      "command": "cargo test",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$rustc",
      "group": "test"
    }
  ]
}
