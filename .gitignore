__pycache__/
*.pyc
*.pyo
*.egg-info/
# web/dist is committed — it contains the compiled frontend that
# the server serves at runtime. Remove this line only if you want
# to require `npm install && npm run build` after every clone.
!web/dist/
build/
.eggs/
*.log
.venv/
venv/
target/
*.so
*.pyd
*.dll
# Generated by `make strength` / `elo_report` (deterministic, reproducible —
# not committed: docs/STRENGTH.md holds the published numbers).
bench/
# NNUE networks are distributed as release assets, not committed to Git
# (see nets/README.md). Remove these lines or use `git add -f` to version one.
nets/*.tkn
nets/*.tkn.zst
training_data/
